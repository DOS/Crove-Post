WHOP_CLIENT_ID="sample_whop_client_id"

# --- MeWe ---
MEWE_HOST="https://mewe.com"
MEWE_APP_ID="sample_mewe_app_id"
MEWE_API_KEY="sample_mewe_api_key"

# --- Farcaster (Neynar API) ---
NEYNAR_CLIENT_ID="sample_neynar_client_id"
